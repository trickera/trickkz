# Cloudflare Pages security headers — applied to every response.
# CSP is strict: no 'unsafe-inline', no 'unsafe-eval', no external origins.
# Everything (fonts, css, js, images) is same-origin. The only fetch() is the
# same-origin "ping", covered by connect-src 'self'.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-DNS-Prefetch-Control: off

# Fingerprinted, immutable assets can be cached hard.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*.jpg
  Cache-Control: public, max-age=604800

# CV PDFs change in place (same filename) — always revalidate so edits show up immediately.
/assets/*.pdf
  Cache-Control: public, max-age=0, must-revalidate
